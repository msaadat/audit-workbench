# Storage and identity.
# WORKBENCH_DATA is the one root everything is derived from: workspace trees at
# <root>/Users/<user_id>/Workspaces/, the control-plane database at
# <root>/workbench.db, and admin-owned assistant settings at <root>/settings.json.
# WORKBENCH_DATA=

# AUTH_MODE is single_user (default) or multi_user. Single-user runs every
# request as one local account and shows no login; it is the local-first
# product. Multi-user resolves the actor from the request session.
# AUTH_MODE=single_user

# The account single-user mode acts as, by id or email. Defaults to the
# built-in local account. Prefer `manage.py bootstrap-admin --adopt-local`,
# which promotes that account in place so no workspace has to move.
# WORKBENCH_LOCAL_USER=

# Keep the control-plane database on local disk if WORKBENCH_DATA is ever a
# network share: SQLite locking over NFS/SMB is not reliable.
# WORKBENCH_DB=

# How long a session survives inactivity. Sliding: active use keeps extending it.
# SESSION_TTL_HOURS=12

# Session cookies are marked Secure when the request arrives over HTTPS (or
# X-Forwarded-Proto says so). Set this explicitly behind a TLS-terminating proxy
# that does not forward the header, or to 0 for a plain-HTTP in-house server.
# SESSION_COOKIE_SECURE=

# Assistant API keys. Copy this file to .env and fill in the keys you use.
# Provider and model are saved from the Assistant settings page.

# Default provider: groq, openrouter, mistral, opencode, cerebras, or lmstudio.
LLM_BACKEND=mistral

# Groq
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Mistral
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-medium-3-5

# OpenCode Zen
# OPENCODE_API_KEY=
# OPENCODE_MODEL=deepseek-v4-flash-free

# Cerebras
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b

# LM Studio local server
# Optional dummy key; defaults to lm-studio if omitted.
# LMSTUDIO_API_KEY=lm-studio
# LMSTUDIO_MODEL=

# Agent runs (optional). The agent uses the assistant's provider/model unless
# these override it — agent runs plan and reason more, so a stronger model
# often pays off. AGENT_PROVIDER must be one of: groq, openrouter, mistral,
# opencode, cerebras, lmstudio (key comes from that provider's variable above).
# AGENT_PROVIDER=
# AGENT_MODEL=

# Document-analysis vision profile (optional). This is configured separately
# in the Documents UI. Custom/local model names must declare vision explicitly.
# AGENT_VISION_PROVIDER=
# AGENT_VISION_MODEL=
# AGENT_VISION_CAPABILITIES=vision

# Agent run admission. The per-user limit is what expresses "wait for your run
# to finish"; the global one is a resource ceiling for the box. Before these were
# split, one auditor's run made every other auditor on the server wait too.
# AGENT_MAX_CONCURRENT_PER_USER=1
# AGENT_MAX_CONCURRENT=4

# Shared-server resource limits.
# Largest single upload accepted (default 512).
# WORKBENCH_MAX_UPLOAD_MB=512
# Per-user storage ceiling. Unset means unlimited, and costs no filesystem walk.
# WORKBENCH_USER_QUOTA_MB=
# In-memory parsed-frame cache budget, evicted least-recently-used (default 2048).
# WORKBENCH_FRAME_CACHE_MB=2048

# Sandbox. Single-user runs snippets in-process, as it always has. Multi-user
# runs them in a bubblewrap jail: no network, and a filesystem holding only the
# interpreter, Polars, and one exchange directory — no dotenv, no Workspaces, no
# control-plane database. Install bubblewrap (bwrap) for this; without it a
# shared server refuses to run Python at all.
# WORKBENCH_SANDBOX_MODE=auto        # auto | inprocess | subprocess | container
# WORKBENCH_SANDBOX_TIMEOUT_SECONDS=60
# WORKBENCH_SANDBOX_MEMORY_MB=2048
# WORKBENCH_SANDBOX_THREADS=2
# WORKBENCH_BWRAP=                   # path to bwrap, if not on PATH

# Last resort for a shared server with no bubblewrap: run snippets in this
# process anyway. That is not an isolation boundary — set it only where every
# user is trusted with everyone else's data and with the provider key above.
# WORKBENCH_ALLOW_INPROCESS_PYTHON=0

# Local debug telemetry level (default 'calls'). All levels are workspace-local.
#   off   - record nothing new; the Debug console still reads existing history.
#   calls - LLM calls, retries, and events. A few writes per model call.
#   full  - also snapshot and diff every durable save. Thorough, but a run
#           saves on every transition, so this costs hundreds of extra file
#           writes and can add tens of megabytes to a workspace.
# DEBUG_TELEMETRY=calls
