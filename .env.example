# Assistant configuration. Copy this file to .env and fill in one backend.

# Optional: groq (default), openrouter, or lmstudio. If only
# OPENROUTER_API_KEY is set, the backend is selected automatically.
# LLM_BACKEND=groq

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenRouter
# LLM_BACKEND=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=~openai/gpt-latest
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_APP_TITLE=Audit Workbench
# OPENROUTER_HTTP_REFERER=

# LM Studio local server
# LLM_BACKEND=lmstudio
# Optional: leave blank to use LM Studio's loaded model.
# LMSTUDIO_MODEL=
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_API_KEY=lm-studio

# Optional: LLM request timeout in seconds. Defaults to 60 for cloud backends
# and 300 for LM Studio.
# LLM_REQUEST_TIMEOUT=

# Optional: store workspaces outside the repo.
# WORKBENCH_DATA=C:\Path\To\AuditWorkbenchData
