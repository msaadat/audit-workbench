{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--no-project", "uvicorn", "app.main:app", "--app-dir", "backend", "--port", "8010", "--reload"],
      "port": 8010,
      "autoPort": false
    },
    {
      "name": "frontend",
      "cwd": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5183", "--strictPort"],
      "port": 5183
    },
    {
      "name": "frontend-alt",
      "cwd": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5184", "--strictPort"],
      "port": 5184
    },
    {
      "name": "app",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--no-project", "uvicorn", "app.main:app", "--app-dir", "backend", "--host", "127.0.0.1", "--port", "8000", "--reload"],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "app-alt",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--no-project", "uvicorn", "app.main:app", "--app-dir", "backend", "--host", "127.0.0.1", "--port", "8011", "--reload"],
      "port": 8011,
      "autoPort": false
    }
  ]
}
