    },
    "rcm_id": "RCM-PAY-01",
    "requirement_refs": [
      "RCM-PAY-01:complete_payroll_cycle"
    ],
    "procedure_key": "payroll-payment-cycle",
    "steps": [],
    "definition": {
      "population": {
        "candidate_id": "CYCLE-CAND-PAYROLL",
        "selection_reason": "Authoritative payroll register at the completed-run stage.",
        "table": "payroll_register",
        "row_key": {
          "column": "PAYROLL_RUN_NUMBER",
          "identifier_kind": "payroll.payroll_run_number"
        },
        "cycle_keys": [
          {
            "column": "PAYSLIP_NUMBER",
            "identifier_kind": "payroll.payslip_number"
          },
          {
            "column": "BANK_PAYMENT_NUMBER",
            "identifier_kind": "payroll.bank_payment_number"
          }
        ],
        "selection": {
          "mode": "evidence_linked",
          "assurance_scope": "targeted_evidence_only"
        }
      },
      "roles": [
        {
          "role": "employment_contract",
          "record_kind": "payroll.employment_contract",
          "required": true,
          "cardinality": "one",
          "reuse_across_items": "allowed"
        },
        {
          "role": "time_record",
          "record_kind": "payroll.time_record",
          "required": true,
          "cardinality": "one",
          "reuse_across_items": "allowed"
        },
        {
          "role": "payroll_register",
          "record_kind": "payroll.payroll_register",
          "required": true,
          "cardinality": "one",
          "reuse_across_items": "allowed"
        },
        {
          "role": "payslip",
          "record_kind": "payroll.payslip",
          "required": true,
          "cardinality": "one",
          "reuse_across_items": "exclusive"
        },
        {
          "role": "bank_payment",
          "record_kind": "payroll.bank_payment",
          "required": true,
          "cardinality": "one",
          "reuse_across_items": "allowed"
        }
      ],
      "assertions": [
        {
          "key": "payslip_to_bank",
          "label": "Net pay agrees to bank payment",
          "left": {
            "source": "role",
            "role": "payslip",
            "field": {
              "group": "amounts",
              "kind": "net_pay",
              "attribute": "value"
            }
          },
          "right": {
            "source": "role",
            "role": "bank_payment",
            "field": {
              "group": "amounts",
              "kind": "total",
              "attribute": "value"
            }
          },
          "operator": "numeric_within",
          "tolerance": {
            "absolute": 0.01,
            "percent": 0
          }
        },
        {
          "key": "period_agrees",
          "label": "Time and payroll periods agree",
          "left": {
            "source": "role",
            "role": "time_record",
            "field": {
              "group": "dates",
              "kind": "pay_period_end",
              "attribute": "value"
            }
          },
          "right": {
            "source": "role",
            "role": "payroll_register",
            "field": {
              "group": "dates",
              "kind": "pay_period_end",
              "attribute": "value"
            }
          },
          "operator": "equal_exact"
        },
        {
          "key": "hours_present",
          "label": "Regular hours are present",
          "left": {
            "source": "role",
            "role": "time_record",
            "field": {
              "group": "quantities",
              "kind": "regular_hours",
              "attribute": "value"
            }
          },
          "operator": "present"
        }
      ],
      "recipe_bindings": [
        {
          "recipe_id": "payroll.net_pay_to_payment",
          "bindings": {
            "payroll_record": "payroll.payslip",
            "payment_record": "payroll.bank_payment"
          }
        },
        {
          "recipe_id": "payroll.pay_period_agreement",
          "bindings": {
            "source": "payroll.time_record",
            "target": "payroll.payroll_register"
          }
        },
        {
          "recipe_id": "common.party_agreement",
          "bindings": {
            "source": "payroll.employment_contract",
            "target": "payroll.payslip"
          }
        }
      ]
    },
